{
  "name": "youpilot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev --host 0.0.0.0",
    "lint": "eslint ./app --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint ./app --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "deploy:dev": "npm run build:dev && wrangler deploy",
    "build:stage": "react-router build --mode stage",
    "deploy:stage": "npm run build:stage && wrangler deploy",
    "build:production": "react-router build --mode production",
    "deploy:production": "npm run build:production && wrangler deploy",
    "preview": "npm run build:dev && vite preview",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "postinstall": "npm run cf-typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply dev_supplyflow --local",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --config=drizzle.local.config.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@iconify/react": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "groq-sdk": "^1.1.2",
    "jose": "^5.9.6",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router": "^7.13.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unpdf": "^1.6.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.22.0",
    "@eslint/js": "^9.20.0",
    "@iconify-json/material-symbols": "^1.2.53",
    "@iconify/tailwind4": "^1.2.1",
    "@libsql/client": "^0.17.4",
    "@react-router/dev": "^7.13.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "global-jsdom": "^27.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.2.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.7",
    "wrangler": "^4.102.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --debug-check"
    ]
  }
}
