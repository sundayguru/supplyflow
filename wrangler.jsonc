{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supplyflow",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supplyflow",
      "database_id": "3f8d50e1-8df5-4e74-b538-035f8a505c67",
      "migrations_dir": "./drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "supplyflow",
    },
  ],
  "vars": {
    "BASE_URL": "https://suploop.com",
    "AI_API_URL": "https://fal.run/openrouter/router/openai/v1",
    "AI_MODEL": "openai/gpt-6-luna",
    "ADMIN_EMAILS": "sundayguru@gmail.com",
    "SENDGRID_FROM_EMAIL": "noreply@suploop.com",
  },
  "routes": [
    {
      "pattern": "suploop.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.suploop.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "production": {
      "name": "prod-supplyflow",
      "triggers": {
        "crons": [
          "* * * * *"
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "supplyflow",
          "database_id": "3f8d50e1-8df5-4e74-b538-035f8a505c67",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "supplyflow",
        },
      ],
      "vars": {
        "BASE_URL": "https://suploop.com",
        "AI_API_URL": "https://fal.run/openrouter/router/openai/v1",
        "AI_MODEL": "openai/gpt-6-luna",
        "ADMIN_EMAILS": "sundayguru@gmail.com",
        "SENDGRID_FROM_EMAIL": "noreply@suploop.com",
      },
    },
    "dev": {
      "name": "dev-supplyflow",
      "routes": [],
      "triggers": {
        "crons": [
          "* * * * *"
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dev_supplyflow",
          "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "supplyflow",
        },
      ],
      "vars": {
        "BASE_URL": "http://localhost:5173",
        "AI_API_URL": "https://fal.run/openrouter/router/openai/v1",
        "AI_MODEL": "openai/gpt-6-luna",
        "ADMIN_EMAILS": "sundayguru@gmail.com",
        "SENDGRID_FROM_EMAIL": "noreply@suploop.com",
      },
    },
  },
}